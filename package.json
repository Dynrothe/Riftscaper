{
    "name": "riftscaper-project",
    "version": "0.1.0",
    "packageManager": "bun@1.3.14",
    "private": true,
    "description": "Riftscaper, an action RPG through randomly generated rifts of Gielinor (riftscaper/), and the engine it's built on (engine/)",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "start": "vite --config riftscaper/vite.config.ts",
        "build": "vite build --config riftscaper/vite.config.ts",
        "preview": "vite preview --config riftscaper/vite.config.ts",
        "riftscaper": "vite --config riftscaper/vite.config.ts",
        "build:riftscaper": "vite build --config riftscaper/vite.config.ts",
        "preview:riftscaper": "vite preview --config riftscaper/vite.config.ts",
        "slim-cache:riftscaper": "tsx riftscaper/scripts/slim-cache.ts",
        "download-caches": "node riftscaper/scripts/download-caches.cjs",
        "test": "vitest run",
        "typecheck": "tsc --noEmit -p engine && tsc --noEmit -p riftscaper"
    },
    "dependencies": {
        "@foxglove/wasm-bz2": "^0.3.0",
        "bzip2": "^0.1.1",
        "denque": "^2.1.0",
        "file-saver": "^2.0.5",
        "gl-matrix": "^3.4.4",
        "java-random": "^0.4.0",
        "js-xxhash": "^5.0.1",
        "jszip": "^3.10.1",
        "leva": "^0.10.1",
        "pako": "^2.1.0",
        "picogl": "^0.17.9",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-joystick-component": "^6.2.1",
        "react-modal": "^3.16.3",
        "react-router-dom": "^7.18.0",
        "react-select": "^5.10.2",
        "threads": "^1.7.0",
        "wasm-gzip": "^2.1.0",
        "webfontloader": "^1.6.28",
        "xxhash-wasm": "^1.1.0"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/adm-zip": "^0.5.7",
        "@types/file-saver": "^2.0.7",
        "@types/node": "^24.0.0",
        "@types/pako": "^2.0.3",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/react-modal": "^3.16.3",
        "@types/webfontloader": "^1.6.35",
        "@vitejs/plugin-react": "^4.7.0",
        "@webgpu/types": "^0.1.70",
        "adm-zip": "^0.5.17",
        "jsdom": "^25.0.1",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "vite": "^6.4.5",
        "vitest": "^3.2.7",
        "yauzl": "^3.2.0"
    }
}
